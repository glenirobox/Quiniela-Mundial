@page "/"
@using ProyectoTecnicasProgra.Data
@layout LayoutVacio
@using ProyectoTecnicasProgra.Models
@inject DatosMemoria Datos
@inject NavigationManager Navigation

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card p-4 shadow-sm" style="width: 380px;">
        <h3 class="text-center mb-4">Iniciar Sesión</h3>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger text-center p-2" role="alert">
                @mensajeError
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Usuario</label>
            <input type="text" class="form-field" @bind="usuarioInput" placeholder="Ej. Admin o Glen" />
        </div>

        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <input type="password" class="form-field" @bind="passwordInput" placeholder="••••••••" />
        </div>

        <button class="btn btn-primary w-100 mt-2" @onclick="ProcesarLogin">
            Ingresar
        </button>
    </div>
</div>

@code {
    private string usuarioInput = string.Empty;
    private string passwordInput = string.Empty;
    private string mensajeError = string.Empty;

    private void ProcesarLogin()
    {
        mensajeError = string.Empty;

        if (string.IsNullOrWhiteSpace(usuarioInput) || string.IsNullOrWhiteSpace(passwordInput))
        {
            mensajeError = "Por favor complete ambos campos.";
            return;
        }

        bool exito = Datos.ValidarLogin(usuarioInput, passwordInput);

        if (exito)
        {
            Navigation.NavigateTo("/home");
        }
        else
        {
            mensajeError = "Usuario o contraseña incorrectos.";
        }
    }
}
