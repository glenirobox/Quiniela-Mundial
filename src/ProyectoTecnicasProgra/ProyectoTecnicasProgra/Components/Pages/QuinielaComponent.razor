@page "/quiniela"
@using ProyectoTecnicasProgra.Data
@using ProyectoTecnicasProgra.Models
@inject DatosMemoria Datos
@inject NavigationManager Navigation

@* Componente para la captura, actualización y evaluación de los pronósticos de los usuarios. *@
<PageTitle>Mis Pronósticos - Quiniela Mundial</PageTitle>

<div class="container py-4">
    <h2 class="mb-4">Ingresar Mis Pronósticos</h2>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
        </div>
    }

    <div class="row g-3">
        @foreach (var partido in Datos.Partidos)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card shadow-sm h-100 border-@(partido.Finalizado ? "secondary" : "primary")">
                    <div class="card-header bg-transparent text-center fw-bold">
                        @partido.Fecha.ToString("dd/MM/yyyy HH:mm")
                        @if (partido.Finalizado)
                        {
                            <span class="badge bg-secondary ms-2">Finalizado</span>
                        }
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="fw-bold fs-6">@partido.EquipoLocal</span>
                            <input type="number" min="0" class="form-control text-center mx-2" style="width: 60px;"
                                   disabled="@partido.Finalizado"
                                   @bind="valoresInput[partido.Id].GolesLocal" />
                            <span>VS</span>
                            <input type="number" min="0" class="form-control text-center mx-2" style="width: 60px;"
                                   disabled="@partido.Finalizado"
                                   @bind="valoresInput[partido.Id].GolesVisitante" />
                            <span class="fw-bold fs-6">@partido.EquipoVisitante</span>
                        </div>

                        @if (partido.Finalizado)
                        {
                            <div class="text-center text-muted small">
                                Resultado Oficial: <strong>@partido.GolesLocal - @partido.GolesVisitante</strong>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-4 text-end">
        <button class="btn btn-success btn-lg" @onclick="GuardarPronosticos">
            Guardar Pronósticos
        </button>
    </div>
</div>

@code {
    private class InputPronostico
    {
        public int? GolesLocal { get; set; }
        public int? GolesVisitante { get; set; }
    }

    private Dictionary<int, InputPronostico> valoresInput = new();
    private string mensajeExito = string.Empty;

    // Carga los marcadores previamente ingresados por el usuario activo
    protected override void OnInitialized()
    {
        if (Datos.UsuarioActual == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        foreach (var partido in Datos.Partidos)
        {
            var existente = Datos.Pronosticos.FirstOrDefault(p =>
                p.Username == Datos.UsuarioActual.Username && p.PartidoId == partido.Id);

            if (existente != null)
            {
                valoresInput[partido.Id] = new InputPronostico
                {
                    GolesLocal = existente.GolesLocalPredichos,
                    GolesVisitante = existente.GolesVisitantePredichos
                };
            }
            else
            {
                valoresInput[partido.Id] = new InputPronostico();
            }
        }
    }

    private void GuardarPronosticos()
    {
        if (Datos.UsuarioActual == null) return;

        foreach (var partido in Datos.Partidos)
        {
            if (valoresInput.ContainsKey(partido.Id))
            {
                var input = valoresInput[partido.Id];

                if (input.GolesLocal.HasValue && input.GolesVisitante.HasValue)
                {
                    var existente = Datos.Pronosticos.FirstOrDefault(p =>
                        p.Username == Datos.UsuarioActual.Username && p.PartidoId == partido.Id);

                    if (existente != null)
                    {
                        existente.GolesLocalPredichos = input.GolesLocal.Value;
                        existente.GolesVisitantePredichos = input.GolesVisitante.Value;
                    }
                    else
                    {
                        Datos.Pronosticos.Add(new Pronostico
                        {
                            Username = Datos.UsuarioActual.Username,
                            PartidoId = partido.Id,
                            GolesLocalPredichos = input.GolesLocal.Value,
                            GolesVisitantePredichos = input.GolesVisitante.Value
                        });
                    }
                }
            }
        }

        // Evaluar e insertar las insignias conseguidas por el usuario
        var nuevasInsignias = Datos.VerificarYOtorgarInsignias(Datos.UsuarioActual.Username);

        if (nuevasInsignias.Any())
        {
            mensajeExito = $"¡Pronósticos guardados!  ¡Has desbloqueado: {string.Join(", ", nuevasInsignias)}!";
        }
        else
        {
            mensajeExito = "¡Pronósticos guardados correctamente!";
        }
    }
}