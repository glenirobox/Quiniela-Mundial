@using ProyectoTecnicasProgra.Data
@inject DatosMemoria Datos
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="home">Quiniela Mundial</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" id="navbar-toggler" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.getElementById('navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="quiniela">
                <span class="bi bi-list-check-nav-menu" aria-hidden="true"></span> Mis Pronósticos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="posiciones">
                <span class="bi bi-trophy-fill-nav-menu" aria-hidden="true"></span> Tabla de Posiciones
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reportes">
                <span class="bi bi-file-earmark-bar-graph-fill-nav-menu" aria-hidden="true"></span> Reportes
            </NavLink>
        </div>

        @if (Datos.UsuarioActual?.Rol == "Admin")
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin-partidos">
                    <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Admin Partidos
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin-usuarios">
                    <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Mantenimiento Usuarios
                </NavLink>
            </div>
        }

        <div class="nav-item px-3">
            <button class="btn btn-link nav-link text-white w-100 text-start" @onclick="CerrarSesion">
                <span class="bi bi-box-arrow-right" aria-hidden="true"></span> Cerrar Sesión
            </button>
        </div>
    </nav>
</div>

@code {
    private void CerrarSesion()
    {
        Datos.UsuarioActual = null;
        Navigation.NavigateTo("/");
    }
}
