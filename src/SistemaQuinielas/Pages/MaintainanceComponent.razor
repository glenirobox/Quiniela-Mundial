@page "/maintainance"
@using SistemaQuinielas.Models
@rendermode InteractiveServer

<div class="card shadow-sm p-4 mt-3">
    <h3 class="mb-3 text-primary"><i class="bi bi-gear-fill me-2"></i>Mantenimiento de Datos</h3>
    <p class="text-muted">Administración general de usuarios, equipos y partidos del sistema.</p>

    <div class="row g-3 mt-2">
        <!-- Gestión de Equipos -->
        <div class="col-md-4">
            <div class="card h-100 border-light bg-light p-3">
                <h5>Equipos</h5>
                <p class="small text-secondary">Registra y edita los equipos participantes.</p>
                <button class="btn btn-outline-primary mt-auto" @onclick="GestionarEquipos">Administrar Equipos</button>
            </div>
        </div>

        <!-- Gestión de Partidos -->
        <div class="col-md-4">
            <div class="card h-100 border-light bg-light p-3">
                <h5>Partidos</h5>
                <p class="small text-secondary">Añade encuentros y actualiza marcadores finales.</p>
                <button class="btn btn-outline-primary mt-auto" @onclick="GestionarPartidos">Administrar Partidos</button>
            </div>
        </div>

        <!-- Gestión de Usuarios -->
        <div class="col-md-4">
            <div class="card h-100 border-light bg-light p-3">
                <h5>Usuarios</h5>
                <p class="small text-secondary">Consulta la lista de participantes registrados.</p>
                <button class="btn btn-outline-primary mt-auto" @onclick="GestionarUsuarios">Administrar Usuarios</button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeSeccion))
    {
        <div class="alert alert-info mt-4" role="alert">
            @mensajeSeccion
        </div>
    }
</div>

@code {
    private string mensajeSeccion = "";

    private void GestionarEquipos()
    {
        mensajeSeccion = "Módulo de gestión de equipos seleccionado.";
    }

    private void GestionarPartidos()
    {
        mensajeSeccion = "Módulo de gestión de partidos y marcadores seleccionado.";
    }

    private void GestionarUsuarios()
    {
        mensajeSeccion = "Módulo de gestión de usuarios seleccionado.";
    }
}